{
	"name": "@acdh-oeaw/openapi-nextjs",
	"version": "0.0.4",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/acdh-oeaw/openapi-nextjs"
	},
	"type": "module",
	"engines": {
		"node": "^22 || ^24 || ^26"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint:check": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings .",
		"lint:fix": "pnpm run lint:check --fix",
		"prepublishOnly": "run-s build",
		"types:check": "tsc --noEmit",
		"test": "exit 0"
	},
	"dependencies": {
		"@scalar/openapi-types": "catalog:"
	},
	"peerDependencies": {
		"@valibot/to-json-schema": "1.x",
		"next": "15.x || 16.x",
		"valibot": "1.x"
	},
	"devDependencies": {
		"@acdh-oeaw/tsconfig-lib": "catalog:",
		"@arethetypeswrong/core": "catalog:",
		"@types/json-schema": "catalog:",
		"@types/node": "catalog:",
		"@valibot/to-json-schema": "catalog:",
		"next": "catalog:",
		"npm-run-all2": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"valibot": "catalog:"
	}
}
