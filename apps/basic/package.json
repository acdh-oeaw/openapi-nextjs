{
	"name": "@acdh-oeaw/openapi-nextjs-example-basic",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^22 || ^24 || ^26"
	},
	"scripts": {
		"app:build": "next build",
		"app:dev": "next dev --turbopack",
		"build": "run-s generate:api-docs app:build",
		"dev": "run-s app:dev",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"generate:api-docs": "NODE_DEBUG=openapi-nextjs tsx ./scripts/generate-api-docs.ts",
		"lint:check": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings .",
		"lint:fix": "pnpm run lint:check --fix",
		"prepare": "run-s types:prepare",
		"start": "next start",
		"test:e2e": "PORT=3001 playwright test",
		"test:e2e:update-snapshots": "PORT=3001 playwright test --update-snapshots",
		"types:check": "tsc --noEmit",
		"types:prepare": "next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "catalog:",
		"@acdh-oeaw/openapi-nextjs": "workspace:^",
		"@scalar/nextjs-api-reference": "catalog:",
		"next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@acdh-oeaw/tsconfig": "catalog:",
		"@playwright/test": "catalog:",
		"@tailwindcss/postcss": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"is-in-ci": "catalog:",
		"npm-run-all2": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"tailwindcss": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
